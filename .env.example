# Environment
ENVIRONMENT=development

# Moonbase core layer (local path in dev, GitHub in prod)
CORE_LAYER_PATH=../moonbase-core

# Public values
PUBLIC_SITE_BASE_URL=http://localhost:3000
PUBLIC_API_BASE_URL=/api

# Private values (server-side API proxy target)
API_BASE_URL=http://localhost:4000/api/v1
